# Voice-Enabled RAG System Configuration

# Gemini API Key (Required for live Gemini generative responses)
GEMINI_API_KEY=your_gemini_api_key_here

# Speech-to-Text Model size: tiny, base, small (tiny/base recommended for sub-100ms)
WHISPER_MODEL_SIZE=base

# Similarity threshold for anti-hallucination guardrail (0.0 to 1.0)
SIMILARITY_THRESHOLD=0.28
